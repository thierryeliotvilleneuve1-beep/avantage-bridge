# ---- Script (obligatoire) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Voix off (choisir UN provider) ----
# Recommande: ElevenLabs -> seul provider qui retourne le timing par caractere,
# ce qui donne des sous-titres mot-a-mot parfaitement synchronises.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Alternative moins chere, sans timings (sous-titres estimes)
# TTS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx

# TTS_PROVIDER=silent  -> piste muette de la bonne duree, pour tester le rendu sans cle

# ---- Visuels ----
# pexels   : banque video/photo reelle, gratuit, cle requise (recommande)
# pollinations : images IA, gratuit, sans cle (qualite variable)
# solid    : fonds unis generes localement, aucun reseau (mode test)
VISUALS_PROVIDER=pexels
PEXELS_API_KEY=

# ---- Divers ----
CHANNEL_CONFIG=config/channel.mindloop.json
