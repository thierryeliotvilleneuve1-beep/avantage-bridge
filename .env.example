PORT=3000
API_KEY=CHANGE_MOI_CLE_SECRETE_LONGUE
BASE44_API_KEY=CHANGE_MOI_CLE_BASE44
BASE44_APP_ID=68927e133cde9f63295dd616
CRON_SCHEDULE=*/15 * * * *
LOG_LEVEL=info

# --- Source de données Avantage ---
# LA DB EST LA SOURCE DE VÉRITÉ : configurer AVANTAGE_DSN et le bridge lit les
# tables Avantage directement (CONTRA, CONPRE, CONACT, TRANS, ACTIVE, PYBBIL,
# COMITE, COMMAN, FACTMA) via ODBC. Créer un DSN système 64 bits dans
# « Sources de données ODBC » de Windows pointé sur la base Avantage.
AVANTAGE_DSN=DSN=AVANTAGE;UID=utilisateur;PWD=motdepasse

# Forcer une source (optionnel) : db | csv. Sans cette variable : db si
# AVANTAGE_DSN est défini, sinon csv (repli sur exports-avantage/*.csv).
# DATA_SOURCE=db

# Encodage des exports CSV (mode repli seulement). Si les accents sortent
# cassés, essayer cp850 ou cp863.
CSV_ENCODING=latin1
CSV_WATCH_DIR=A:\AVA01
