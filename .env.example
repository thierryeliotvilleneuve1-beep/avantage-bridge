PORT=3000
API_KEY=CHANGE_MOI_CLE_SECRETE_LONGUE
CSV_WATCH_DIR=A:\AVA01
CRON_SCHEDULE=*/15 * * * *
BASE44_API_KEY=de56105e236d42d29d2f2c75e84fb9ad
BASE44_APP_ID=68927e133cde9f63295dd616
LOG_LEVEL=info

# Répertoire des exports Avantage. Laisser vide pour utiliser ./exports-avantage
AVANTAGE_EXPORT_DIR=

# ------------------------------------------------------------------------------
# Lecture directe de la base Avantage — état des résultats
# ------------------------------------------------------------------------------
# LECTURE SEULE. Le bridge n'écrit jamais dans la comptabilité Avantage : seuls les
# SELECT sont acceptés, tout le reste est refusé avant d'atteindre le pilote ODBC.
#
# MISE EN SERVICE — deux lignes, aucune installation :
#   1. AVANTAGE_DSN=<nom du DSN ODBC d'Avantage>
#   2. AVANTAGE_BD_ACTIVE=true
#   3. Relancer le bridge et appeler GET /api/etat-resultats/mappage
#
# Sous Windows, le bridge lit la base via PowerShell et System.Data.Odbc, livrés avec
# l'OS : ni node-gyp, ni Build Tools Visual Studio. Les noms de colonnes sont déduits
# automatiquement puis validés sur les données réelles — rien à transcrire à la main.
# Toute table dont la déduction échoue continue d'être lue dans son export CSV.

# Nom du DSN ODBC, ou chaîne de connexion ODBC complète
AVANTAGE_DSN=
AVANTAGE_BD_UTILISATEUR=
AVANTAGE_BD_MOTDEPASSE=
# Garde-fou : sans true, aucune connexion à la base n'est tentée
AVANTAGE_BD_ACTIVE=false

# ------------------------------------------------------------------------------
# Notifications, alertes budgétaires et résumé hebdo IA (optionnel)
# ------------------------------------------------------------------------------
# Canal Teams : webhook entrant (Incoming Webhook classique OU flux Power Automate
# « Post to a channel when a webhook request is received » qui lit le champ `text`).
# Laisser vide = aucune notification (no-op silencieux).
TEAMS_WEBHOOK_URL=

# Alertes budgétaires par exception (dépassement / seuil). true par défaut.
ALERTES_ACTIF=true
# Seuil d'avertissement : 0.9 = alerte quand le coût atteint 90 % du budget.
BUDGET_ALERTE_SEUIL=0.9
# Alerte « sync en retard » si aucun sync réussi depuis X minutes (défaut 45).
MONITEUR_FRAICHEUR_MIN=45

# Résumé hebdomadaire rédigé par Claude, envoyé sur Teams. Nécessite une clé API Anthropic.
ANTHROPIC_API_KEY=
# Modèle Claude (défaut claude-opus-5 ; mettre claude-sonnet-5 pour réduire le coût).
ANTHROPIC_MODEL=claude-opus-5
RESUME_HEBDO_ACTIF=true
# Cron du résumé (UTC). Défaut : lundi 07h00 (heure serveur selon node-cron).
RESUME_HEBDO_CRON=0 7 * * 1
# auto | powershell | natif   (auto préfère le module npm odbc s'il est présent)
AVANTAGE_BD_VOIE=auto
# Délai maximal d'une requête, en millisecondes
AVANTAGE_BD_DELAI_MS=180000
