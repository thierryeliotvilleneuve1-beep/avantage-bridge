PORT=3000
API_KEY=<cle-secrete-longue-du-bridge>
BASE44_API_KEY=<cle-api-base44>
BASE44_APP_ID=<app-id-base44>

# --- Source des donnees Avantage ---
# odbc = lecture directe de la BD (recommande), xlsx = export Excel,
# auto = odbc des qu'une connexion ODBC est configuree
AVANTAGE_SOURCE=auto
ODBC_DSN=AVANTAGE
# ODBC_UID=
# ODBC_PWD=
# Alternative au DSN: chaine complete
# ODBC_CONNECTION_STRING=Driver={Pervasive ODBC Interface};ServerName=SERVEUR;DBQ=AVA01;
# Style de guillemets si le pilote refuse les doubles guillemets: none | bracket
# ODBC_QUOTE=
# Repli sur export.xlsx si la BD est injoignable
FALLBACK_XLSX=true

# Dossier des exports Avantage (par defaut: ./exports-avantage)
# EXPORT_DIR=C:\CRC\avantage-bridge-v7\bridge-v7\exports-avantage

# Frequence du sync automatique
CRON_SCHEDULE=*/15 * * * *

# true = le cron pousse aussi budget + BC + transactions (pas seulement projets/factures)
FULL_SYNC_ON_CRON=true

# 'auto' = tous les projets actifs de Manoeuvre, ou liste: P23020,P24011
SYNC_PROJETS=auto

# Declenche un sync des qu'un nouvel export.xlsx est depose
WATCH_EXPORT=true

# false = repousse tous les projets meme sans changement (sync complet force)
SKIP_UNCHANGED=true

# Au-dela de ce delai, /api/status signale des donnees perimees
MAX_EXPORT_AGE_HOURS=24

LOG_LEVEL=info
