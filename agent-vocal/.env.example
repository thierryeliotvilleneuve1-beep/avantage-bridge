# ── Standard 24 — variables d'environnement ────────────────────────────────
# Copier ce fichier en .env et remplir. Ne jamais commiter le .env.

# Serveur
PORT=8080
# URL publique du serveur (obligatoire — Twilio doit pouvoir rejoindre le WebSocket)
# Ex. https://agent.standard24.ca  ou  https://abc123.ngrok.app en developpement
URL_PUBLIQUE=
# Cle d'acces a la console d'administration
CLE_ADMIN=CHANGE_MOI_CLE_LONGUE_ET_ALEATOIRE

# ── Intelligence (Anthropic) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
MODELE_LLM=claude-opus-5
# Effort de raisonnement : low = latence minimale (recommande pour la voix)
EFFORT_LLM=low
# Bascule automatique vers un modele de repli si un refus survient
FALLBACK_LLM=true

# ── Reconnaissance vocale (Deepgram) ───────────────────────────────────────
DEEPGRAM_API_KEY=
MODELE_STT=nova-2
LANGUE_STT=fr-CA

# ── Synthese vocale (ElevenLabs) ───────────────────────────────────────────
ELEVENLABS_API_KEY=
# Voix par defaut si le client n'en precise pas une
VOIX_DEFAUT=
MODELE_TTS=eleven_flash_v2_5

# ── Telephonie : Twilio (porte d'entree des appels) ────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero 418/514/450/438 achete chez Twilio, vers lequel Telus Business
# Connect renvoie les appels. Format E.164.
TWILIO_NUMERO=

# ── Telephonie : Telus Business Connect (RingCentral en marque blanche) ────
# Optionnel — sert au SMS de suivi, au journal d'appels et a la configuration
# automatique des regles de renvoi. L'agent fonctionne sans.
TBC_SERVER_URL=https://platform.ringcentral.com
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_JWT=
# Numero principal de l'entreprise dans TBC (pour l'envoi de SMS)
TBC_NUMERO_SMS=

# ── Notifications ──────────────────────────────────────────────────────────
# Envoi des messages pris par l'agent (laisser vide pour desactiver)
SMTP_HOTE=
SMTP_PORT=587
SMTP_USAGER=
SMTP_MOTDEPASSE=
SMTP_EXPEDITEUR=
